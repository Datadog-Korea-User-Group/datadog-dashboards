{
  "integration": "nginx_ingress_controller",
  "description": "ingress-nginx controller -> Datadog nginx_ingress.controller.* (labels kept: ingress, namespace, service, status, method, path, host, controller_class, controller_pod, controller_namespace, state).",
  "entries": [
    { "prom": "nginx_ingress_controller_requests", "dd": "nginx_ingress.controller.requests", "kind": "counter" },
    { "prom": "nginx_ingress_controller_request_duration_seconds_bucket", "dd": "nginx_ingress.controller.request.duration.seconds.bucket", "kind": "counter" },
    { "prom": "nginx_ingress_controller_request_duration_seconds_sum", "dd": "nginx_ingress.controller.request.duration.seconds.sum", "kind": "counter" },
    { "prom": "nginx_ingress_controller_request_duration_seconds_count", "dd": "nginx_ingress.controller.request.duration.seconds.count", "kind": "counter" },
    { "prom": "nginx_ingress_controller_response_duration_seconds_bucket", "dd": "nginx_ingress.controller.response.duration.seconds.bucket", "kind": "counter" },
    { "prom": "nginx_ingress_controller_response_duration_seconds_sum", "dd": "nginx_ingress.controller.response.duration.seconds.sum", "kind": "counter" },
    { "prom": "nginx_ingress_controller_response_duration_seconds_count", "dd": "nginx_ingress.controller.response.duration.seconds.count", "kind": "counter" },
    { "prom": "nginx_ingress_controller_request_size_bucket", "dd": "nginx_ingress.controller.request.size.bucket", "kind": "counter" },
    { "prom": "nginx_ingress_controller_request_size_sum", "dd": "nginx_ingress.controller.request.size.sum", "kind": "counter" },
    { "prom": "nginx_ingress_controller_response_size_bucket", "dd": "nginx_ingress.controller.response.size.bucket", "kind": "counter" },
    { "prom": "nginx_ingress_controller_response_size_sum", "dd": "nginx_ingress.controller.response.size.sum", "kind": "counter" },
    { "prom": "nginx_ingress_controller_bytes_sent_bucket", "dd": "nginx_ingress.controller.bytes.sent.bucket", "kind": "counter" },
    { "prom": "nginx_ingress_controller_bytes_sent_sum", "dd": "nginx_ingress.controller.bytes.sent.sum", "kind": "counter" },
    { "prom": "nginx_ingress_controller_ingress_upstream_latency_seconds", "dd": "nginx_ingress.controller.ingress.upstream.latency.seconds.quantile", "kind": "gauge" },
    { "prom": "nginx_ingress_controller_ingress_upstream_latency_seconds_sum", "dd": "nginx_ingress.controller.ingress.upstream.latency.seconds.sum", "kind": "counter" },
    { "prom": "nginx_ingress_controller_ingress_upstream_latency_seconds_count", "dd": "nginx_ingress.controller.ingress.upstream.latency.seconds.count", "kind": "counter" },
    { "prom": "nginx_ingress_controller_nginx_process_connections", "dd": "nginx_ingress.controller.nginx.process.connections", "kind": "gauge" },
    { "prom": "nginx_ingress_controller_nginx_process_connections_total", "dd": "nginx_ingress.controller.nginx.process.connections.total", "kind": "counter" },
    { "prom": "nginx_ingress_controller_nginx_process_requests_total", "dd": "nginx_ingress.controller.nginx.process.requests.total", "kind": "counter" },
    { "prom": "nginx_ingress_controller_nginx_process_cpu_seconds_total", "dd": "nginx_ingress.controller.nginx.process.cpu.seconds.total", "kind": "counter" },
    { "prom": "nginx_ingress_controller_nginx_process_resident_memory_bytes", "dd": "nginx_ingress.controller.nginx.process.resident.memory.bytes", "kind": "gauge" },
    { "prom": "nginx_ingress_controller_nginx_process_virtual_memory_bytes", "dd": "nginx_ingress.controller.nginx.process.virtual.memory.bytes", "kind": "gauge" },
    { "prom": "nginx_ingress_controller_nginx_process_read_bytes_total", "dd": "nginx_ingress.controller.nginx.process.read.bytes.total", "kind": "counter" },
    { "prom": "nginx_ingress_controller_nginx_process_write_bytes_total", "dd": "nginx_ingress.controller.nginx.process.write.bytes.total", "kind": "counter" },
    { "prom": "nginx_ingress_controller_success", "dd": "nginx_ingress.controller.success", "kind": "counter" },
    { "prom": "nginx_ingress_controller_config_last_reload_successful", "dd": "nginx_ingress.controller.config.last.reload.successful", "kind": "gauge" },
    { "prom": "nginx_ingress_controller_config_hash", "dd": "nginx_ingress.controller.config.hash", "kind": "gauge" },
    { "prom": "nginx_ingress_controller_ssl_expire_time_seconds", "dd": "nginx_ingress.controller.ssl.expire.time.seconds", "kind": "gauge" },
    { "prom": "nginx_ingress_controller_leader_election_status", "dd": "nginx_ingress.controller.leader.election.status", "kind": "gauge" }
