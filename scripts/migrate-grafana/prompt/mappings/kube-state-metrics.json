{
  "integration": "kubernetes_state",
  "description": "kube-state-metrics -> Datadog kubernetes_state.* (Cluster Agent KSM core check). Tags follow the _tags.json renames (namespace->kube_namespace, pod->pod_name, deployment->kube_deployment ...).",
  "entries": [
    { "prom": "kube_pod_status_phase", "dd": "kubernetes_state.pod.status_phase", "kind": "gauge", "tags": { "phase": "pod_phase" } },
    { "prom": "kube_pod_info", "dd": "kubernetes_state.pod.count", "kind": "gauge" },
    { "prom": "kube_pod_container_status_restarts_total", "dd": "kubernetes_state.container.restarts", "kind": "gauge", "note": "cumulative gauge; increase() -> diff(...)" },
    { "prom": "kube_pod_container_status_ready", "dd": "kubernetes_state.container.ready", "kind": "gauge" },
    { "prom": "kube_pod_container_status_running", "dd": "kubernetes_state.container.running", "kind": "gauge" },
    { "prom": "kube_pod_container_status_waiting_reason", "dd": "kubernetes_state.container.status_report.count.waiting", "kind": "gauge", "tags": { "reason": "reason" } },
    { "prom": "kube_pod_container_status_terminated_reason", "dd": "kubernetes_state.container.status_report.count.terminated", "kind": "gauge", "tags": { "reason": "reason" } },
    { "prom": "kube_pod_container_resource_requests", "match": { "resource": "cpu" }, "dd": "kubernetes_state.container.cpu_requested", "kind": "gauge" },
    { "prom": "kube_pod_container_resource_requests", "match": { "resource": "memory" }, "dd": "kubernetes_state.container.memory_requested", "kind": "gauge" },
    { "prom": "kube_pod_container_resource_limits", "match": { "resource": "cpu" }, "dd": "kubernetes_state.container.cpu_limit", "kind": "gauge" },
    { "prom": "kube_pod_container_resource_limits", "match": { "resource": "memory" }, "dd": "kubernetes_state.container.memory_limit", "kind": "gauge" },
    { "prom": "kube_pod_container_resource_requests_cpu_cores", "dd": "kubernetes_state.container.cpu_requested", "kind": "gauge" },
    { "prom": "kube_pod_container_resource_requests_memory_bytes", "dd": "kubernetes_state.container.memory_requested", "kind": "gauge" },
    { "prom": "kube_pod_container_resource_limits_cpu_cores", "dd": "kubernetes_state.container.cpu_limit", "kind": "gauge" },
    { "prom": "kube_pod_container_resource_limits_memory_bytes", "dd": "kubernetes_state.container.memory_limit", "kind": "gauge" },
    { "prom": "kube_deployment_status_replicas", "dd": "kubernetes_state.deployment.replicas", "kind": "gauge" },
    { "prom": "kube_deployment_status_replicas_available", "dd": "kubernetes_state.deployment.replicas_available", "kind": "gauge" },
    { "prom": "kube_deployment_status_replicas_unavailable", "dd": "kubernetes_state.deployment.replicas_unavailable", "kind": "gauge" },
    { "prom": "kube_deployment_status_replicas_updated", "dd": "kubernetes_state.deployment.replicas_updated", "kind": "gauge" },
    { "prom": "kube_deployment_spec_replicas", "dd": "kubernetes_state.deployment.replicas_desired", "kind": "gauge" },
    { "prom": "kube_replicaset_status_replicas", "dd": "kubernetes_state.replicaset.replicas", "kind": "gauge" },
    { "prom": "kube_replicaset_status_ready_replicas", "dd": "kubernetes_state.replicaset.replicas_ready", "kind": "gauge" },
    { "prom": "kube_replicaset_spec_replicas", "dd": "kubernetes_state.replicaset.replicas_desired", "kind": "gauge" },
    { "prom": "kube_daemonset_status_number_ready", "dd": "kubernetes_state.daemonset.ready", "kind": "gauge" },
    { "prom": "kube_daemonset_status_desired_number_scheduled", "dd": "kubernetes_state.daemonset.desired", "kind": "gauge" },
    { "prom": "kube_daemonset_status_current_number_scheduled", "dd": "kubernetes_state.daemonset.scheduled", "kind": "gauge" },
    { "prom": "kube_daemonset_status_number_misscheduled", "dd": "kubernetes_state.daemonset.misscheduled", "kind": "gauge" },
    { "prom": "kube_daemonset_status_number_unavailable", "dd": "kubernetes_state.daemonset.unavailable", "kind": "gauge" },
    { "prom": "kube_statefulset_status_replicas", "dd": "kubernetes_state.statefulset.replicas", "kind": "gauge" },
    { "prom": "kube_statefulset_status_replicas_ready", "dd": "kubernetes_state.statefulset.replicas_ready", "kind": "gauge" },
    { "prom": "kube_statefulset_replicas", "dd": "kubernetes_state.statefulset.replicas_desired", "kind": "gauge" },
    { "prom": "kube_job_status_succeeded", "dd": "kubernetes_state.job.succeeded", "kind": "gauge" },
    { "prom": "kube_job_status_failed", "dd": "kubernetes_state.job.failed", "kind": "gauge" },
    { "prom": "kube_job_status_active", "dd": "kubernetes_state.job.active", "kind": "gauge" },
    { "prom": "kube_hpa_status_current_replicas", "dd": "kubernetes_state.hpa.current_replicas", "kind": "gauge" },
    { "prom": "kube_hpa_status_desired_replicas", "dd": "kubernetes_state.hpa.desired_replicas", "kind": "gauge" },
    { "prom": "kube_hpa_spec_max_replicas", "dd": "kubernetes_state.hpa.max_replicas", "kind": "gauge" },
    { "prom": "kube_hpa_spec_min_replicas", "dd": "kubernetes_state.hpa.min_replicas", "kind": "gauge" },
    { "prom": "kube_horizontalpodautoscaler_status_current_replicas", "dd": "kubernetes_state.hpa.current_replicas", "kind": "gauge" },
    { "prom": "kube_horizontalpodautoscaler_status_desired_replicas", "dd": "kubernetes_state.hpa.desired_replicas", "kind": "gauge" },
    { "prom": "kube_node_status_condition", "dd": "kubernetes_state.node.by_condition", "kind": "gauge", "tags": { "condition": "condition", "status": "status" } },
    { "prom": "kube_node_info", "dd": "kubernetes_state.node.count", "kind": "gauge" },
    { "prom": "kube_node_spec_unschedulable", "dd": "kubernetes_state.node.status", "kind": "gauge", "note": "unschedulable nodes; status tag" },
    { "prom": "kube_node_status_allocatable", "match": { "resource": "cpu" }, "dd": "kubernetes_state.node.cpu_allocatable", "kind": "gauge" },
    { "prom": "kube_node_status_allocatable", "match": { "resource": "memory" }, "dd": "kubernetes_state.node.memory_allocatable", "kind": "gauge" },
    { "prom": "kube_node_status_allocatable", "match": { "resource": "pods" }, "dd": "kubernetes_state.node.pods_allocatable", "kind": "gauge" },
    { "prom": "kube_node_status_capacity", "match": { "resource": "cpu" }, "dd": "kubernetes_state.node.cpu_capacity", "kind": "gauge" },
    { "prom": "kube_node_status_capacity", "match": { "resource": "memory" }, "dd": "kubernetes_state.node.memory_capacity", "kind": "gauge" },
    { "prom": "kube_node_status_capacity", "match": { "resource": "pods" }, "dd": "kubernetes_state.node.pods_capacity", "kind": "gauge" },
    { "prom": "kube_node_status_allocatable_cpu_cores", "dd": "kubernetes_state.node.cpu_allocatable", "kind": "gauge" },
    { "prom": "kube_node_status_allocatable_memory_bytes", "dd": "kubernetes_state.node.memory_allocatable", "kind": "gauge" },
    { "prom": "kube_node_status_capacity_cpu_cores", "dd": "kubernetes_state.node.cpu_capacity", "kind": "gauge" },
    { "prom": "kube_node_status_capacity_memory_bytes", "dd": "kubernetes_state.node.memory_capacity", "kind": "gauge" },
    { "prom": "kube_node_status_capacity_pods", "dd": "kubernetes_state.node.pods_capacity", "kind": "gauge" },
    { "prom": "kube_node_status_allocatable_pods", "dd": "kubernetes_state.node.pods_allocatable", "kind": "gauge" },
    { "prom": "kube_persistentvolumeclaim_status_phase", "dd": "kubernetes_state.persistentvolumeclaim.status", "kind": "gauge", "tags": { "phase": "phase" } },
    { "prom": "kube_persistentvolumeclaim_resource_requests_storage_bytes", "dd": "kubernetes_state.persistentvolumeclaim.request_storage", "kind": "gauge" },
    { "prom": "kube_persistentvolume_status_phase", "dd": "kubernetes_state.persistentvolume.by_phase", "kind": "gauge", "tags": { "phase": "phase" } },
    { "prom": "kube_namespace_status_phase", "dd": "kubernetes_state.namespace.count", "kind": "gauge", "tags": { "phase": "phase" } },
    { "prom": "kube_service_info", "dd": "kubernetes_state.service.count", "kind": "gauge" },
    { "prom": "kube_endpoint_address_available", "dd": "kubernetes_state.endpoint.address_available", "kind": "gauge" },
    { "prom": "kube_endpoint_address_not_ready", "dd": "kubernetes_state.endpoint.address_not_ready", "kind": "gauge" },
    { "prom": "kube_cronjob_status_active", "dd": "kubernetes_state.cronjob.count", "kind": "gauge" },
    { "prom": "kube_resourcequota", "dd": "kubernetes_state.resourcequota.cpu.used", "kind": "gauge", "note": "kubernetes_state.resourcequota.<resource>.<used|limit>" },
    { "prom": "kube_pod_created", "dd": "kubernetes_state.pod.age", "kind": "gauge", "note": "time() - kube_pod_created == kubernetes_state.pod.age" },
    { "prom": "kube_pod_start_time", "dd": "kubernetes_state.pod.uptime", "kind": "gauge" }
  ]
}
