{
  "integration": "kubernetes",
  "description": "kubelet / cAdvisor container metrics -> Datadog kubernetes.* (Agent kubelet check). kubernetes.cpu.usage.total is in nanocores (rate of container_cpu_usage_seconds_total * 1e9).",
  "entries": [
    { "prom": "container_cpu_usage_seconds_total", "dd": "kubernetes.cpu.usage.total", "kind": "rate", "scale": 1e-9, "note": "nanocores; divide by 1e9 for cores" },
    { "prom": "container_cpu_user_seconds_total", "dd": "kubernetes.cpu.user.total", "kind": "rate", "scale": 1e-9 },
    { "prom": "container_cpu_system_seconds_total", "dd": "kubernetes.cpu.system.total", "kind": "rate", "scale": 1e-9 },
    { "prom": "container_cpu_cfs_throttled_periods_total", "dd": "kubernetes.cpu.cfs.throttled.periods", "kind": "counter" },
    { "prom": "container_cpu_cfs_periods_total", "dd": "kubernetes.cpu.cfs.periods", "kind": "counter" },
    { "prom": "container_cpu_cfs_throttled_seconds_total", "dd": "kubernetes.cpu.cfs.throttled.seconds", "kind": "counter" },
    { "prom": "container_spec_cpu_quota", "dd": "kubernetes.cpu.limits", "kind": "gauge", "note": "cores (quota/period)" },
    { "prom": "container_spec_cpu_shares", "dd": "kubernetes.cpu.requests", "kind": "gauge", "note": "cores (shares/1024)" },
    { "prom": "container_memory_working_set_bytes", "dd": "kubernetes.memory.working_set", "kind": "gauge" },
    { "prom": "container_memory_usage_bytes", "dd": "kubernetes.memory.usage", "kind": "gauge" },
    { "prom": "container_memory_rss", "dd": "kubernetes.memory.rss", "kind": "gauge" },
    { "prom": "container_memory_cache", "dd": "kubernetes.memory.cache", "kind": "gauge" },
    { "prom": "container_memory_swap", "dd": "kubernetes.memory.swap", "kind": "gauge" },
    { "prom": "container_spec_memory_limit_bytes", "dd": "kubernetes.memory.limits", "kind": "gauge" },
    { "prom": "container_memory_max_usage_bytes", "dd": "kubernetes.memory.usage", "kind": "gauge" },
    { "prom": "container_network_receive_bytes_total", "dd": "kubernetes.network.rx_bytes", "kind": "rate" },
    { "prom": "container_network_transmit_bytes_total", "dd": "kubernetes.network.tx_bytes", "kind": "rate" },
    { "prom": "container_network_receive_errors_total", "dd": "kubernetes.network.rx_errors", "kind": "rate" },
    { "prom": "container_network_transmit_errors_total", "dd": "kubernetes.network.tx_errors", "kind": "rate" },
    { "prom": "container_network_receive_packets_dropped_total", "dd": "kubernetes.network.rx_dropped", "kind": "rate" },
    { "prom": "container_network_transmit_packets_dropped_total", "dd": "kubernetes.network.tx_dropped", "kind": "rate" },
    { "prom": "container_fs_usage_bytes", "dd": "kubernetes.filesystem.usage", "kind": "gauge" },
    { "prom": "container_fs_limit_bytes", "dd": "kubernetes.filesystem.usage_pct", "kind": "gauge", "note": "Datadog exposes usage_pct instead of a limit" },
    { "prom": "container_fs_reads_bytes_total", "dd": "kubernetes.io.read_bytes", "kind": "rate" },
    { "prom": "container_fs_writes_bytes_total", "dd": "kubernetes.io.write_bytes", "kind": "rate" },
    { "prom": "kubelet_running_pods", "dd": "kubernetes.pods.running", "kind": "gauge" },
    { "prom": "kubelet_running_pod_count", "dd": "kubernetes.pods.running", "kind": "gauge" },
    { "prom": "kubelet_running_containers", "dd": "kubernetes.containers.running", "kind": "gauge" },
    { "prom": "kubelet_running_container_count", "dd": "kubernetes.containers.running", "kind": "gauge" },
    { "prom": "kubelet_volume_stats_used_bytes", "dd": "kubernetes.kubelet.volume.stats.used_bytes", "kind": "gauge" },
    { "prom": "kubelet_volume_stats_capacity_bytes", "dd": "kubernetes.kubelet.volume.stats.capacity_bytes", "kind": "gauge" },
    { "prom": "kubelet_volume_stats_available_bytes", "dd": "kubernetes.kubelet.volume.stats.available_bytes", "kind": "gauge" },
    { "prom": "kubelet_volume_stats_inodes_used", "dd": "kubernetes.kubelet.volume.stats.inodes_used", "kind": "gauge" },
    { "prom": "kubelet_volume_stats_inodes", "dd": "kubernetes.kubelet.volume.stats.inodes", "kind": "gauge" },
    { "prom": "kubelet_pleg_relist_duration_seconds", "dd": "kubernetes.kubelet.pleg.relist_duration", "kind": "distribution" },
    { "prom": "kubelet_runtime_operations_errors_total", "dd": "kubernetes.kubelet.runtime.errors", "kind": "counter" },
    { "prom": "kube_apiserver_request_total", "dd": "kube_apiserver.apiserver_request_total.count", "kind": "counter" },
    { "prom": "apiserver_request_total", "dd": "kube_apiserver.apiserver_request_total.count", "kind": "counter" },
    { "prom": "apiserver_request_duration_seconds_bucket", "dd": "kube_apiserver.apiserver_request_duration_seconds.bucket", "kind": "counter" },
    { "prom": "etcd_server_has_leader", "dd": "etcd.server.has_leader", "kind": "gauge" },
    { "prom": "coredns_dns_requests_total", "dd": "coredns.request_count", "kind": "counter" },
    { "prom": "coredns_dns_responses_total", "dd": "coredns.response_code_count", "kind": "counter" },
    { "prom": "coredns_cache_hits_total", "dd": "coredns.cache_hits_count", "kind": "counter" },
    { "prom": "coredns_cache_misses_total", "dd": "coredns.cache_misses_count", "kind": "counter" },
    { "prom": "coredns_dns_request_duration_seconds_bucket", "dd": "coredns.request_duration.seconds.bucket", "kind": "counter" }
  ]
}
