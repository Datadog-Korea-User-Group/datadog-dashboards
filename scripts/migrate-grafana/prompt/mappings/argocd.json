{
  "integration": "argocd",
  "description": "Argo CD -> Datadog argocd.* (argocd integration, OpenMetrics based; labels kept as tags: name, namespace, project, dest_server, health_status, sync_status, phase, operation, grpc_service, grpc_method, grpc_code, repo, request_type, response_code, verb, resource_kind).",
  "entries": [
    { "prom": "argocd_app_info", "dd": "argocd.app_controller.app.info", "kind": "gauge" },
    { "prom": "argocd_app_sync_total", "dd": "argocd.app_controller.app.sync.count", "kind": "counter" },
    { "prom": "argocd_app_reconcile_count", "dd": "argocd.app_controller.app.reconcile.count", "kind": "counter" },
    { "prom": "argocd_app_reconcile_sum", "dd": "argocd.app_controller.app.reconcile.sum", "kind": "counter" },
    { "prom": "argocd_app_reconcile_bucket", "dd": "argocd.app_controller.app.reconcile.bucket", "kind": "counter" },
    { "prom": "argocd_app_k8s_request_total", "dd": "argocd.app_controller.app.k8s.request.count", "kind": "counter" },
    { "prom": "argocd_cluster_info", "dd": "argocd.app_controller.cluster.info", "kind": "gauge" },
    { "prom": "argocd_cluster_api_resources", "dd": "argocd.app_controller.cluster.api.resources", "kind": "gauge" },
    { "prom": "argocd_cluster_api_resource_objects", "dd": "argocd.app_controller.cluster.api.resource.objects", "kind": "gauge" },
    { "prom": "argocd_cluster_cache_age_seconds", "dd": "argocd.app_controller.cluster.cache.age.seconds", "kind": "gauge" },
    { "prom": "argocd_cluster_connection_status", "dd": "argocd.app_controller.cluster.connection.status", "kind": "gauge" },
    { "prom": "argocd_cluster_events_total", "dd": "argocd.app_controller.cluster.events.count", "kind": "counter" },
    { "prom": "argocd_kubectl_exec_pending", "dd": "argocd.app_controller.kubectl.exec.pending", "kind": "gauge" },
    { "prom": "argocd_kubectl_exec_total", "dd": "argocd.app_controller.kubectl.exec.count", "kind": "counter" },
    { "prom": "argocd_redis_request_total", "dd": "argocd.app_controller.redis.request.count", "kind": "counter" },
    { "prom": "argocd_redis_request_duration_bucket", "dd": "argocd.app_controller.redis.request.duration.bucket", "kind": "counter" },
    { "prom": "workqueue_depth", "dd": "argocd.app_controller.workqueue.depth", "kind": "gauge" },
    { "prom": "workqueue_adds_total", "dd": "argocd.app_controller.workqueue.adds.count", "kind": "counter" },
    { "prom": "workqueue_queue_duration_seconds_bucket", "dd": "argocd.app_controller.workqueue.queue.duration.seconds.bucket", "kind": "counter" },
    { "prom": "argocd_git_request_total", "dd": "argocd.repo_server.git.request.count", "kind": "counter" },
    { "prom": "argocd_git_request_duration_seconds_bucket", "dd": "argocd.repo_server.git.request.duration.seconds.bucket", "kind": "counter" },
    { "prom": "argocd_git_request_duration_seconds_sum", "dd": "argocd.repo_server.git.request.duration.seconds.sum", "kind": "counter" },
    { "prom": "argocd_git_request_duration_seconds_count", "dd": "argocd.repo_server.git.request.duration.seconds.count", "kind": "counter" },
    { "prom": "argocd_repo_pending_request_total", "dd": "argocd.repo_server.repo.pending.request.total", "kind": "gauge" },
    { "prom": "grpc_server_handled_total", "dd": "argocd.api_server.grpc.server.handled.count", "kind": "counter" },
    { "prom": "grpc_server_started_total", "dd": "argocd.api_server.grpc.server.started.count", "kind": "counter" },
    { "prom": "grpc_server_msg_received_total", "dd": "argocd.api_server.grpc.server.msg.received.count", "kind": "counter" },
    { "prom": "grpc_server_msg_sent_total", "dd": "argocd.api_server.grpc.server.msg.sent.count", "kind": "counter" },
    { "prom": "argocd_notifications_deliveries_total", "dd": "argocd.notifications_controller.deliveries.count", "kind": "counter" },
    { "prom": "argocd_notifications_trigger_eval_total", "dd": "argocd.notifications_controller.trigger.eval.count", "kind": "counter" },
    { "prom": "process_cpu_seconds_total", "dd": "argocd.app_controller.process.cpu.seconds.count", "kind": "counter", "note": "component prefix varies: app_controller | api_server | repo_server" },
    { "prom": "process_resident_memory_bytes", "dd": "argocd.app_controller.process.resident.memory.bytes", "kind": "gauge" },
    { "prom": "go_goroutines", "dd": "argocd.app_controller.go.goroutines", "kind": "gauge" },
    { "prom": "go_memstats_heap_alloc_bytes", "dd": "argocd.app_controller.go.memstats.heap.alloc.bytes", "kind": "gauge" }
  ]
}
