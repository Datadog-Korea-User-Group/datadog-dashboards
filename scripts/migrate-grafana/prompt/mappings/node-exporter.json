{
  "integration": "system",
  "description": "Prometheus node_exporter -> Datadog Agent system checks (system.cpu/mem/disk/io/net/load). Datadog CPU metrics are already percentages (0-100) per host, memory metrics are in MiB, disk in bytes, io in KiB/s.",
  "entries": [
    { "prom": "node_cpu_seconds_total", "match": { "mode": "idle" }, "dd": "system.cpu.idle", "kind": "percent", "note": "percent of CPU idle; rate(idle)/count(cpu) -> avg:system.cpu.idle / 100" },
    { "prom": "node_cpu_seconds_total", "match": { "mode": "user" }, "dd": "system.cpu.user", "kind": "percent" },
    { "prom": "node_cpu_seconds_total", "match": { "mode": "system" }, "dd": "system.cpu.system", "kind": "percent" },
    { "prom": "node_cpu_seconds_total", "match": { "mode": "iowait" }, "dd": "system.cpu.iowait", "kind": "percent" },
    { "prom": "node_cpu_seconds_total", "match": { "mode": "steal" }, "dd": "system.cpu.stolen", "kind": "percent" },
    { "prom": "node_cpu_seconds_total", "match": { "mode": "irq" }, "dd": "system.cpu.interrupt", "kind": "percent" },
    { "prom": "node_cpu_seconds_total", "match": { "mode": "softirq" }, "dd": "system.cpu.interrupt", "kind": "percent" },
    { "prom": "node_cpu_seconds_total", "dd": "system.cpu.idle", "kind": "percent", "note": "no mode filter: overall busy = 100 - system.cpu.idle" },
    { "prom": "node_load1", "dd": "system.load.1", "kind": "gauge" },
    { "prom": "node_load5", "dd": "system.load.5", "kind": "gauge" },
    { "prom": "node_load15", "dd": "system.load.15", "kind": "gauge" },
    { "prom": "node_memory_MemTotal_bytes", "dd": "system.mem.total", "kind": "gauge", "note": "MiB in Datadog; multiply by 1048576 for bytes" },
    { "prom": "node_memory_MemAvailable_bytes", "dd": "system.mem.usable", "kind": "gauge" },
    { "prom": "node_memory_MemFree_bytes", "dd": "system.mem.free", "kind": "gauge" },
    { "prom": "node_memory_Buffers_bytes", "dd": "system.mem.buffered", "kind": "gauge" },
    { "prom": "node_memory_Cached_bytes", "dd": "system.mem.cached", "kind": "gauge" },
    { "prom": "node_memory_Shmem_bytes", "dd": "system.mem.shared", "kind": "gauge" },
    { "prom": "node_memory_Slab_bytes", "dd": "system.mem.slab", "kind": "gauge" },
    { "prom": "node_memory_SwapTotal_bytes", "dd": "system.swap.total", "kind": "gauge" },
    { "prom": "node_memory_SwapFree_bytes", "dd": "system.swap.free", "kind": "gauge" },
    { "prom": "node_memory_SwapCached_bytes", "dd": "system.swap.cached", "kind": "gauge" },
    { "prom": "node_filesystem_size_bytes", "dd": "system.disk.total", "kind": "gauge", "tags": { "mountpoint": "device", "device": "device_name" } },
    { "prom": "node_filesystem_avail_bytes", "dd": "system.disk.free", "kind": "gauge", "tags": { "mountpoint": "device", "device": "device_name" } },
    { "prom": "node_filesystem_free_bytes", "dd": "system.disk.free", "kind": "gauge", "tags": { "mountpoint": "device", "device": "device_name" } },
    { "prom": "node_disk_read_bytes_total", "dd": "system.io.rkb_s", "kind": "rate", "tags": { "device": "device" }, "note": "KiB/s (Datadog scales the display)" },
    { "prom": "node_disk_written_bytes_total", "dd": "system.io.wkb_s", "kind": "rate", "tags": { "device": "device" } },
    { "prom": "node_disk_reads_completed_total", "dd": "system.io.r_s", "kind": "rate", "tags": { "device": "device" } },
    { "prom": "node_disk_writes_completed_total", "dd": "system.io.w_s", "kind": "rate", "tags": { "device": "device" } },
    { "prom": "node_disk_io_time_seconds_total", "dd": "system.io.util", "kind": "percent", "tags": { "device": "device" }, "note": "percent busy; rate(io_time)*100 == system.io.util" },
    { "prom": "node_disk_read_time_seconds_total", "dd": "system.io.await", "kind": "rate", "tags": { "device": "device" }, "note": "approximation: Datadog reports average wait ms" },
    { "prom": "node_network_receive_bytes_total", "dd": "system.net.bytes_rcvd", "kind": "rate", "tags": { "device": "device" } },
    { "prom": "node_network_transmit_bytes_total", "dd": "system.net.bytes_sent", "kind": "rate", "tags": { "device": "device" } },
    { "prom": "node_network_receive_packets_total", "dd": "system.net.packets_in.count", "kind": "rate", "tags": { "device": "device" } },
    { "prom": "node_network_transmit_packets_total", "dd": "system.net.packets_out.count", "kind": "rate", "tags": { "device": "device" } },
    { "prom": "node_network_receive_errs_total", "dd": "system.net.packets_in.error", "kind": "rate", "tags": { "device": "device" } },
    { "prom": "node_network_transmit_errs_total", "dd": "system.net.packets_out.error", "kind": "rate", "tags": { "device": "device" } },
    { "prom": "node_network_receive_drop_total", "dd": "system.net.packets_in.drop", "kind": "rate", "tags": { "device": "device" } },
    { "prom": "node_network_transmit_drop_total", "dd": "system.net.packets_out.drop", "kind": "rate", "tags": { "device": "device" } },
    { "prom": "node_boot_time_seconds", "dd": "system.uptime", "kind": "gauge", "note": "time() - node_boot_time_seconds == system.uptime (seconds)" },
    { "prom": "node_context_switches_total", "dd": "system.cpu.context_switches", "kind": "counter" },
    { "prom": "node_filefd_allocated", "dd": "system.fs.file_handles.allocated", "kind": "gauge" },
    { "prom": "node_filefd_maximum", "dd": "system.fs.file_handles.max", "kind": "gauge" },
    { "prom": "node_procs_running", "dd": "system.proc.count", "kind": "gauge" },
    { "prom": "node_procs_blocked", "dd": "system.proc.queue_length", "kind": "gauge" },
    { "prom": "node_nf_conntrack_entries", "dd": "system.net.conntrack.count", "kind": "gauge" },
    { "prom": "node_nf_conntrack_entries_limit", "dd": "system.net.conntrack.max", "kind": "gauge" },
    { "prom": "node_sockstat_TCP_inuse", "dd": "system.net.tcp4.current_established", "kind": "gauge" },
    { "prom": "node_sockstat_sockets_used", "dd": "system.net.sockets.used", "kind": "gauge" }
  ]
}
