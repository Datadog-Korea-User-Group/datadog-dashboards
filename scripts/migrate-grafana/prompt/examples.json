[
  { "input": { "id": "1.A", "expr": "sum(rate(http_requests_total{job=~\"$job\",code=~\"5.*\"}[5m])) by (handler)", "panel": { "title": "5xx", "type": "timeseries", "unit": "reqps", "legendFormat": "{{handler}}" }, "variables": [{ "name": "job", "prefix": "job" }] },
    "output": { "id": "1.A", "status": "openmetrics", "queries": [{ "name": "query1", "query": "sum:http_requests.count{$job,code:5*} by {handler}.as_rate()" }], "formula": "query1", "unmappedMetrics": ["http_requests_total"], "notes": [] } },
  { "input": { "id": "2.A", "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\",instance=\"$node\",job=\"$job\"}[5m])))", "panel": { "title": "CPU Busy", "type": "gauge", "unit": "percent" }, "variables": [{ "name": "node", "prefix": "instance" }, { "name": "job", "prefix": "job" }] },
    "output": { "id": "2.A", "status": "native", "queries": [{ "name": "query1", "query": "avg:system.cpu.idle{$node}", "aggregator": "last" }], "formula": "100 - query1", "tagRenames": { "instance": "host" }, "unmappedMetrics": [], "notes": ["job filter dropped (native metric)"] } },
  { "input": { "id": "3.A", "expr": "node_memory_MemAvailable_bytes{instance=\"$node\"} / node_memory_MemTotal_bytes{instance=\"$node\"}", "panel": { "title": "RAM available", "type": "stat", "unit": "percentunit" }, "variables": [{ "name": "node", "prefix": "instance" }] },
    "output": { "id": "3.A", "status": "native", "queries": [{ "name": "query1", "query": "avg:system.mem.usable{$node}", "aggregator": "last" }, { "name": "query2", "query": "avg:system.mem.total{$node}", "aggregator": "last" }], "formula": "query1 / query2", "tagRenames": { "instance": "host" }, "unmappedMetrics": [], "notes": [] } },
  { "input": { "id": "4.A", "expr": "node_memory_MemTotal_bytes{instance=\"$node\"} - node_memory_MemAvailable_bytes{instance=\"$node\"}", "panel": { "title": "RAM used", "type": "timeseries", "unit": "bytes", "legendFormat": "used" }, "variables": [{ "name": "node", "prefix": "instance" }] },
    "output": { "id": "4.A", "status": "native", "queries": [{ "name": "query1", "query": "avg:system.mem.total{$node}" }, { "name": "query2", "query": "avg:system.mem.usable{$node}" }], "formula": "(query1 - query2) * 1048576", "tagRenames": { "instance": "host" }, "unmappedMetrics": [], "notes": ["system.mem.* are MiB; scaled to bytes"] } },
  { "input": { "id": "5.A", "expr": "irate(node_network_receive_bytes_total{instance=\"$node\",device!~\"lo\"}[5m]) * 8", "panel": { "title": "Network in", "type": "timeseries", "unit": "bps", "legendFormat": "{{device}}" }, "variables": [{ "name": "node", "prefix": "instance" }] },
    "output": { "id": "5.A", "status": "native", "queries": [{ "name": "query1", "query": "avg:system.net.bytes_rcvd{$node,!device:lo} by {device}" }], "formula": "query1 * 8", "tagRenames": { "instance": "host" }, "unmappedMetrics": [], "notes": [] } },
  { "input": { "id": "6.A", "expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\", phase=\"Running\"})", "panel": { "title": "Running pods", "type": "stat", "unit": "short" }, "variables": [{ "name": "namespace", "prefix": "namespace" }] },
    "output": { "id": "6.A", "status": "native", "queries": [{ "name": "query1", "query": "sum:kubernetes_state.pod.status_phase{$namespace,pod_phase:running}", "aggregator": "last" }], "formula": "query1", "tagRenames": { "namespace": "kube_namespace", "phase": "pod_phase" }, "unmappedMetrics": [], "notes": [] } },
  { "input": { "id": "7.A", "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"$pod\", container!=\"\"}[5m])) by (pod)", "panel": { "title": "CPU usage", "type": "timeseries", "unit": "short", "legendFormat": "{{pod}}" }, "variables": [{ "name": "namespace", "prefix": "namespace" }, { "name": "pod", "prefix": "pod" }] },
    "output": { "id": "7.A", "status": "native", "queries": [{ "name": "query1", "query": "sum:kubernetes.cpu.usage.total{$namespace,$pod,kube_container_name:*} by {pod_name}" }], "formula": "query1 / 1000000000", "tagRenames": { "namespace": "kube_namespace", "pod": "pod_name", "container": "kube_container_name" }, "unmappedMetrics": [], "notes": ["kubernetes.cpu.usage.total is nanocores; scaled to cores"] } },
  { "input": { "id": "8.A", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"$job\"}[5m])) by (le, handler))", "panel": { "title": "p95 latency", "type": "timeseries", "unit": "s", "legendFormat": "{{handler}}" }, "variables": [{ "name": "job", "prefix": "job" }] },
    "output": { "id": "8.A", "status": "partial", "queries": [{ "name": "query1", "query": "p95:http_request_duration_seconds{$job} by {handler}" }], "formula": "query1", "unmappedMetrics": ["http_request_duration_seconds_bucket"], "notes": ["histogram_quantile -> p95 on a distribution; requires histogram_buckets_as_distributions: true"] } },
  { "input": { "id": "9.A", "expr": "histogram_quantile(0.5, sum(rate(argocd_app_reconcile_bucket{namespace=~\"$namespace\"}[5m])) by (le))", "panel": { "title": "Reconcile p50", "type": "timeseries", "unit": "s" }, "variables": [{ "name": "namespace", "prefix": "namespace" }] },
    "output": { "id": "9.A", "status": "partial", "queries": [{ "name": "query1", "query": "p50:argocd.app_controller.app.reconcile{$namespace}" }], "formula": "query1", "unmappedMetrics": [], "notes": ["histogram_quantile -> p50 on a distribution; requires histogram_buckets_as_distributions: true"] } },
  { "input": { "id": "10.A", "expr": "topk(5, sum(rate(nginx_ingress_controller_requests[5m])) by (ingress))", "panel": { "title": "Top ingresses", "type": "timeseries", "unit": "reqps", "legendFormat": "{{ingress}}" }, "variables": [] },
    "output": { "id": "10.A", "status": "native", "queries": [{ "name": "query1", "query": "sum:nginx_ingress.controller.requests{*} by {ingress}.as_rate()" }], "formula": "top(query1, 5, 'mean', 'desc')", "unmappedMetrics": [], "notes": [] } },
  { "input": { "id": "11.A", "expr": "count(count(node_cpu_seconds_total{instance=\"$node\"}) by (cpu))", "panel": { "title": "CPU cores", "type": "stat", "unit": "short" }, "variables": [{ "name": "node", "prefix": "instance" }] },
    "output": { "id": "11.A", "status": "native", "queries": [{ "name": "query1", "query": "avg:system.cpu.num_cores{$node}", "aggregator": "last" }], "formula": "query1", "tagRenames": { "instance": "host" }, "unmappedMetrics": [], "notes": [] } },
  { "input": { "id": "12.A", "expr": "sum(increase(argocd_app_sync_total{namespace=~\"$namespace\",phase=\"Failed\"}[1h]))", "panel": { "title": "Failed syncs", "type": "stat", "unit": "short" }, "variables": [{ "name": "namespace", "prefix": "namespace" }] },
    "output": { "id": "12.A", "status": "native", "queries": [{ "name": "query1", "query": "sum:argocd.app_controller.app.sync.count{$namespace,phase:failed}.as_count()", "aggregator": "sum" }], "formula": "query1", "unmappedMetrics": [], "notes": [] } },
  { "input": { "id": "13.A", "expr": "up{job=\"$job\"}", "panel": { "title": "Up", "type": "stat", "unit": "none" }, "variables": [{ "name": "job", "prefix": "job" }] },
    "output": { "id": "13.A", "status": "unsupported", "queries": [], "formula": "", "unmappedMetrics": [], "notes": ["Prometheus `up` has no Datadog metric; use the openmetrics.health service check"] } },
  { "input": { "id": "14.A", "expr": "sum(rate(process_cpu_seconds_total{job=\"$job\"}[5m])) * 100", "panel": { "title": "Process CPU", "type": "timeseries", "unit": "percent" }, "variables": [{ "name": "job", "prefix": "job" }] },
    "output": { "id": "14.A", "status": "openmetrics", "queries": [{ "name": "query1", "query": "sum:process_cpu_seconds.count{$job}.as_rate()" }], "formula": "query1 * 100", "unmappedMetrics": ["process_cpu_seconds_total"], "notes": [] } },
  { "input": { "id": "15.A", "expr": "avg_over_time(node_load1{instance=\"$node\"}[10m])", "panel": { "title": "Load 1m (10m avg)", "type": "timeseries", "unit": "short" }, "variables": [{ "name": "node", "prefix": "instance" }] },
    "output": { "id": "15.A", "status": "native", "queries": [{ "name": "query1", "query": "avg:system.load.1{$node}.rollup(avg, 600)" }], "formula": "query1", "tagRenames": { "instance": "host" }, "unmappedMetrics": [], "notes": [] } },
  { "input": { "id": "16.A", "expr": "node_filesystem_avail_bytes{instance=\"$node\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{instance=\"$node\",fstype!~\"tmpfs|overlay\"}", "panel": { "title": "Disk free", "type": "timeseries", "unit": "percentunit", "legendFormat": "{{mountpoint}}" }, "variables": [{ "name": "node", "prefix": "instance" }] },
    "output": { "id": "16.A", "status": "partial", "queries": [{ "name": "query1", "query": "avg:system.disk.free{$node} by {device}" }, { "name": "query2", "query": "avg:system.disk.total{$node} by {device}" }], "formula": "query1 / query2", "tagRenames": { "instance": "host", "mountpoint": "device" }, "unmappedMetrics": [], "notes": ["fstype filter dropped (no Datadog tag on system.disk.*)"] } },
  { "input": { "id": "17.A", "expr": "rate(node_disk_io_time_seconds_total{instance=\"$node\"}[5m]) * 100", "panel": { "title": "Disk utilization", "type": "timeseries", "unit": "percent", "legendFormat": "{{device}}" }, "variables": [{ "name": "node", "prefix": "instance" }] },
    "output": { "id": "17.A", "status": "native", "queries": [{ "name": "query1", "query": "avg:system.io.util{$node} by {device}" }], "formula": "query1", "tagRenames": { "instance": "host" }, "unmappedMetrics": [], "notes": ["system.io.util is already a percentage"] } },
  { "input": { "id": "18.A", "expr": "sum(kube_deployment_status_replicas_available{namespace=\"$namespace\"}) / sum(kube_deployment_spec_replicas{namespace=\"$namespace\"})", "panel": { "title": "Deployment availability", "type": "gauge", "unit": "percentunit" }, "variables": [{ "name": "namespace", "prefix": "namespace" }] },
    "output": { "id": "18.A", "status": "native", "queries": [{ "name": "query1", "query": "sum:kubernetes_state.deployment.replicas_available{$namespace}", "aggregator": "last" }, { "name": "query2", "query": "sum:kubernetes_state.deployment.replicas_desired{$namespace}", "aggregator": "last" }], "formula": "query1 / query2", "tagRenames": { "namespace": "kube_namespace" }, "unmappedMetrics": [], "notes": [] } },
  { "input": { "id": "19.A", "expr": "label_replace(rate(foo_total{job=\"$job\"}[5m]), \"svc\", \"$1\", \"job\", \"(.*)\")", "panel": { "title": "foo", "type": "timeseries", "unit": "short", "legendFormat": "{{svc}}" }, "variables": [{ "name": "job", "prefix": "job" }] },
    "output": { "id": "19.A", "status": "partial", "queries": [{ "name": "query1", "query": "avg:foo.count{$job} by {job}.as_rate()" }], "formula": "query1", "unmappedMetrics": ["foo_total"], "notes": ["label_replace dropped; grouped by the source label job"] } },
  { "input": { "id": "20.A", "expr": "sum(rate(http_requests_total[5m])) by (status) / ignoring(status) group_left sum(rate(http_requests_total[5m]))", "panel": { "title": "Status share", "type": "timeseries", "unit": "percentunit", "legendFormat": "{{status}}" }, "variables": [] },
    "output": { "id": "20.A", "status": "partial", "queries": [{ "name": "query1", "query": "sum:http_requests.count{*} by {status}.as_rate()" }, { "name": "query2", "query": "sum:http_requests.count{*}.as_rate()" }], "formula": "query1 / query2", "unmappedMetrics": ["http_requests_total"], "notes": ["vector matching (ignoring/group_left) dropped; Datadog joins on shared tags"] } },
  { "input": { "id": "21.A", "expr": "(node_memory_SwapTotal_bytes{instance=\"$node\"} > bool 0) * ((node_memory_SwapTotal_bytes{instance=\"$node\"} - node_memory_SwapFree_bytes{instance=\"$node\"}) / (node_memory_SwapTotal_bytes{instance=\"$node\"} + 1))", "panel": { "title": "Swap used", "type": "gauge", "unit": "percentunit" }, "variables": [{ "name": "node", "prefix": "instance" }] },
    "output": { "id": "21.A", "status": "partial", "queries": [{ "name": "query1", "query": "avg:system.swap.total{$node}", "aggregator": "last" }, { "name": "query2", "query": "avg:system.swap.free{$node}", "aggregator": "last" }], "formula": "(query1 - query2) / (query1 + 1)", "tagRenames": { "instance": "host" }, "unmappedMetrics": [], "notes": ["`> bool 0` guard dropped (no comparisons in Datadog formulas)"] } },
  { "input": { "id": "22.A", "expr": "time() - node_boot_time_seconds{instance=\"$node\"}", "panel": { "title": "Uptime", "type": "stat", "unit": "s" }, "variables": [{ "name": "node", "prefix": "instance" }] },
    "output": { "id": "22.A", "status": "native", "queries": [{ "name": "query1", "query": "avg:system.uptime{$node}", "aggregator": "last" }], "formula": "query1", "tagRenames": { "instance": "host" }, "unmappedMetrics": [], "notes": [] } },
  { "input": { "id": "23.A", "expr": "sum(nginx_ingress_controller_nginx_process_connections{state=\"active\"})", "panel": { "title": "Active connections", "type": "stat", "unit": "short" }, "variables": [] },
    "output": { "id": "23.A", "status": "native", "queries": [{ "name": "query1", "query": "sum:nginx_ingress.controller.nginx.process.connections{state:active}", "aggregator": "last" }], "formula": "query1", "unmappedMetrics": [], "notes": [] } },
  { "input": { "id": "24.A", "expr": "sum(rate(nginx_ingress_controller_requests{status=~\"5..\"}[5m])) by (ingress)", "panel": { "title": "5xx by ingress", "type": "timeseries", "unit": "reqps", "legendFormat": "{{ingress}}" }, "variables": [] },
    "output": { "id": "24.A", "status": "native", "queries": [{ "name": "query1", "query": "sum:nginx_ingress.controller.requests{status:5*} by {ingress}.as_rate()" }], "formula": "query1", "unmappedMetrics": [], "notes": [] } },
  { "input": { "id": "25.A", "expr": "max(kube_node_status_condition{condition=\"Ready\",status=\"true\"})", "panel": { "title": "Nodes ready", "type": "stat", "unit": "short" }, "variables": [] },
    "output": { "id": "25.A", "status": "native", "queries": [{ "name": "query1", "query": "max:kubernetes_state.node.by_condition{condition:ready,status:true}", "aggregator": "last" }], "formula": "query1", "unmappedMetrics": [], "notes": [] } },
  { "input": { "id": "26.A", "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m]))", "panel": { "title": "Network out", "type": "timeseries", "unit": "Bps", "legendFormat": "{{instance}}" }, "variables": [] },
    "output": { "id": "26.A", "status": "native", "queries": [{ "name": "query1", "query": "sum:system.net.bytes_sent{!device:lo} by {host}" }], "formula": "query1", "tagRenames": { "instance": "host" }, "unmappedMetrics": [], "notes": [] } },
  { "input": { "id": "27.A", "expr": "probe_success{instance=~\"$target\"}", "panel": { "title": "Probe", "type": "stat", "unit": "none", "legendFormat": "{{instance}}" }, "variables": [{ "name": "target", "prefix": "instance" }] },
    "output": { "id": "27.A", "status": "openmetrics", "queries": [{ "name": "query1", "query": "avg:probe_success{$target} by {instance}", "aggregator": "last" }], "formula": "query1", "unmappedMetrics": ["probe_success"], "notes": [] } },
  { "input": { "id": "28.A", "expr": "sum(rate(node_cpu_seconds_total{mode!=\"idle\",instance=\"$node\"}[5m])) by (mode)", "panel": { "title": "CPU by mode", "type": "timeseries", "unit": "percentunit", "legendFormat": "{{mode}}" }, "variables": [{ "name": "node", "prefix": "instance" }] },
    "output": { "id": "28.A", "status": "partial", "queries": [{ "name": "query1", "query": "avg:system.cpu.user{$node}" }, { "name": "query2", "query": "avg:system.cpu.system{$node}" }, { "name": "query3", "query": "avg:system.cpu.iowait{$node}" }, { "name": "query4", "query": "avg:system.cpu.stolen{$node}" }], "formula": "(query1 + query2 + query3 + query4) / 100", "tagRenames": { "instance": "host" }, "unmappedMetrics": [], "notes": ["by (mode) split into per-mode Datadog metrics (user/system/iowait/stolen); shown as one summed series"] } }
]
