# --- web app ---
DATABASE_URL=postgres://dashboards:dashboards@localhost:5432/dashboards
AUTH_SECRET=change-me            # openssl rand -base64 32
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
ADMIN_GITHUB_LOGINS=             # comma-separated GitHub logins that get the admin role (secret; never commit real values)

# --- preview worker (docker compose service "worker") ---
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com
DOGSTATSD_HOST=host.docker.internal   # a Datadog Agent with DogStatsD reachable from the worker
DOGSTATSD_PORT=8125
PREVIEW_FEED_MINUTES=10
PREVIEW_MAX_SERIES=3000

# --- one-time Grafana migration (scripts/migrate-grafana), local only ---
DD_PAT=                          # alternative to DD_API_KEY + DD_APP_KEY (Bearer). Never commit.
